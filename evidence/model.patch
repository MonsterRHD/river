++	payload, err := json.Marshal(controlEvent)
++	if err != nil {
++		return nil, err
++	}
++
++	if err := tx.NotifyMany(ctx, &riverdriver.NotifyManyParams{
++		Payload: []string{string(payload)},
++		Schema:  c.config.Schema,
++		Topic:   string(notifier.NotificationTopicControl),
