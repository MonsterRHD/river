+			Now:        p.Time.NowOrNil(),
+			QueueName:  p.config.Queue,
+			Schema:     p.config.Schema,
+			TTL:        p.config.LeaseTTL,
 		})
 	})
 	if err != nil && errors.Is(context.Cause(ctx), startstop.ErrStop) {
