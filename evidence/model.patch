++		c.baseService.Logger.ErrorContext(
++			ctx,
++			c.baseService.Name+": Failed to send queue drain control notification",
++			slog.String("queue", queueName),
++			slog.String("err", err.Error()),
++		)
++		return nil, err
++	}
++
++	return controlEvent, nil
++}
