+		workers := NewWorkers()
+		AddWorker(workers, &queueDrainWorker{ctxErrCh: ctxErrCh, releaseCh: releaseCh, startedCh: startedCh})
+		AddWorker(workers, &queueDrainRescueWorker{startedCh: rescueCh})
