+		exec := driver.GetExecutor()
+
+		// An active draining handoff with no running jobs.
+		_, err = exec.QueueDrainInsert(ctx, &riverdriver.QueueDrainInsertParams{
+			Key:    "flip-key",
+			Queue:  queueDrainQueueName,
+			Schema: schema,
+		})
+		require.NoError(t, err)
