+		&i.ExpiresAt,
+		&i.ReapedAt,
+	)
+	return &i, err
+}
+
+const producerReapExpired = `-- name: ProducerReapExpired :many
+UPDATE /* TEMPLATE: schema */river_producer
+SET
+    reaped_at = coalesce(cast(?1 AS text), datetime('now', 'subsec'))
+WHERE (queue_name, client_id) IN (
+    SELECT
+        queue_name,
+        client_id
+    FROM /* TEMPLATE: schema */river_producer
+    WHERE
+        expires_at < coalesce(cast(?1 AS text), datetime('now', 'subsec'))
+        AND reaped_at IS NULL
+    ORDER BY
+        expires_at ASC,
+        queue_name ASC,
+        client_id ASC
+    LIMIT ?2
+)
+    AND expires_at < coalesce(cast(?1 AS text), datetime('now', 'subsec'))
+    AND reaped_at IS NULL
+RETURNING queue_name, client_id, producer_id, generation, max_workers, created_at, updated_at, expires_at, reaped_at
+`
+
+type ProducerReapExpiredParams struct {
+	Now *string
+	Max int64
+}
+
+func (q *Queries) ProducerReapExpired(ctx context.Context, db DBTX, arg *ProducerReapExpiredParams) ([]*RiverProducer, error) {
+	rows, err := db.QueryContext(ctx, producerReapExpired, arg.Now, arg.Max)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var items []*RiverProducer
+	for rows.Next() {
+		var i RiverProducer
+		if err := rows.Scan(
+			&i.QueueName,
+			&i.ClientID,
+			&i.ProducerID,
+			&i.Generation,
+			&i.MaxWorkers,
+			&i.CreatedAt,
+			&i.UpdatedAt,
+			&i.ExpiresAt,
+			&i.ReapedAt,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, &i)
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
