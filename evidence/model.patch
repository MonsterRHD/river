+		arg.TTL,
+		arg.QueueName,
+		arg.ClientID,
+		arg.Generation,
+	)
+	var i RiverProducer
+	err := row.Scan(
+		&i.QueueName,
+		&i.ClientID,
+		&i.ProducerID,
+		&i.Generation,
+		&i.MaxWorkers,
+		&i.CreatedAt,
+		&i.UpdatedAt,
+		&i.ExpiresAt,
+		&i.ReapedAt,
+	)
+	return &i, err
+}
+
+const producerReapExpired = `-- name: ProducerReapExpired :many
+WITH expired_producers AS (
+    SELECT
+        queue_name,
+        client_id
+    FROM /* TEMPLATE: schema */river_producer
+    WHERE
+        expires_at < coalesce($1::timestamptz, now())
+        AND reaped_at IS NULL
+    ORDER BY
+        expires_at ASC,
+        queue_name ASC,
+        client_id ASC
+    LIMIT $2::bigint
+    FOR UPDATE
+    SKIP LOCKED
+)
+UPDATE /* TEMPLATE: schema */river_producer
+SET
+    reaped_at = coalesce($1::timestamptz, now())
+FROM expired_producers
+WHERE
+    river_producer.queue_name = expired_producers.queue_name
+    AND river_producer.client_id = expired_producers.client_id
+    AND river_producer.expires_at < coalesce($1::timestamptz, now())
+    AND river_producer.reaped_at IS NULL
+RETURNING river_producer.queue_name, river_producer.client_id, river_producer.producer_id, river_producer.generation, river_producer.max_workers, river_producer.created_at, river_producer.updated_at, river_producer.expires_at, river_producer.reaped_at
+`
+
+type ProducerReapExpiredParams struct {
+	Now *time.Time
+	Max int64
+}
+
+func (q *Queries) ProducerReapExpired(ctx context.Context, db DBTX, arg *ProducerReapExpiredParams) ([]*RiverProducer, error) {
+	rows, err := db.QueryContext(ctx, producerReapExpired, arg.Now, arg.Max)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	var items []*RiverProducer
+	for rows.Next() {
+		var i RiverProducer
+		if err := rows.Scan(
+			&i.QueueName,
+			&i.ClientID,
+			&i.ProducerID,
+			&i.Generation,
+			&i.MaxWorkers,
+			&i.CreatedAt,
+			&i.UpdatedAt,
+			&i.ExpiresAt,
+			&i.ReapedAt,
+		); err != nil {
+			return nil, err
+		}
+		items = append(items, &i)
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return items, nil
+}
