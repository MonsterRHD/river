+		go func() {
+			defer close(keepAliveDone)
+			for i := range count {
+				renewTime := time.Now().UTC()
+				_, err := bundle.exec.ProducerKeepAlive(ctx, &riverdriver.ProducerKeepAliveParams{
+					ClientID:   fmt.Sprintf("client-race-%02d", i),
+					Generation: 1,
