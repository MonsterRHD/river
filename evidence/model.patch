+        queue_name,
+        client_id
+    FROM /* TEMPLATE: schema */river_producer
+    WHERE
+        expires_at < coalesce(sqlc.narg('now')::timestamptz, now())
+        AND reaped_at IS NULL
+    ORDER BY
+        expires_at ASC,
+        queue_name ASC,
+        client_id ASC
+    LIMIT @max::bigint
+    FOR UPDATE
+    SKIP LOCKED
+)
+UPDATE /* TEMPLATE: schema */river_producer
